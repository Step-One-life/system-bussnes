# Параметры удалённого хоста для деплоя (make deploy-server).
# Скопируй в .env.host и заполни. Файл .env.host в .gitignore.

# SSH-доступ
HOST_SSH_USER=deploy
HOST_SSH_HOST=your.server.example
HOST_SSH_PORT=22
# Пароль для sshpass. ЛУЧШЕ оставить пустым и ходить по SSH-ключу:
# пароль виден в списке процессов на машине, с которой идёт деплой.
HOST_SSH_PASS=

# Домен и каталог проекта на хосте
HOST_DOMAIN=your-domain.example
HOST_PROJECT_DIR=/home/deploy/sites/your-domain.example
